# ====== Obligatorias ======
# Base de datos PostgreSQL (Supabase o Neon). En Supabase usá la cadena del "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://usuario:clave@host:5432/base
# Dirección pública de la aplicación, sin barra final
APP_URL=https://turnos.tudominio.com.ar
# Secretos largos y aleatorios (generalos con: openssl rand -base64 48)
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
# Primer acceso al panel (se crea el usuario la primera vez que ingresás). Mínimo 10 caracteres.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ====== Google Calendar (docs/google-calendar.md) ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ====== WhatsApp Business – Meta Cloud API (docs/whatsapp.md) ======
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ====== Correo electrónico por SMTP (docs/correo.md) ======
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Consultorio <turnos@tudominio.com.ar>"
